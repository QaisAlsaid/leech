# ============ discord ============
DISCORD_TOKEN=YOUR_DISCORD_TOKEN
BOT_ID=YOUR_BOT_ID
OWNER_ID=YOUR_OWNER_ID

# ============ prefixes ============
# what triggers the bot's own commands
PREFIXES=">, $"

# ============ storage ============
# json (default) or supabase. json writes into LEECH_STORE_DIR
# (default persistent/v2). see MIGRATE-SUPABASE.md before flipping.
LEECH_STORE=json
# LEECH_STORE_DIR=persistent/v2
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service-role-key>   (or SUPABASE_KEY)

# ============ time ============
# the bot's home timezone: due times like "tomorrow 9am" read in it,
# and it is the fallback for users without `>todo tz set=...`
# LEECH_TZ=Asia/Damascus

# ============ ai (direct, no server needed) ============
# API keys - either provider works, chain order is yours
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GROQ_API_KEY=YOUR_GROQ_API_KEY
# which models are tried, in order: provider:model
AI_CHAIN="groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite"
# thinking effort (low, high, off)
AI_THINKING=low
# whole-turn deadline in seconds (model calls + command rounds)
AI_TURN_DEADLINE=75
# per-request read timeout in seconds
AI_TIMEOUT=20
# context window: message count + total char budget
AI_WINDOW_LIMIT=60
AI_WINDOW_BUDGET=8000
# how long the ai waits on ONE command before letting it run in the
# background (ytdlp/tts take minutes)
# AI_COMMAND_TIMEOUT=45
# how long you have to answer an ask-mode "allow me to run X?" prompt
# AI_CONFIRM_TIMEOUT=120

# ============ ai (via leech-server, overrides direct keys) ============
# LEECH_AI_URL=http://localhost:8000
# LEECH_AI_TOKEN=
# LEECH_AI_BACKEND=auto        # auto | manager | direct

# ============ optional satellites ============
# leech-server tts / ytdlp / hub workers. unset = feature skipped or
# handled locally.
# LEECH_TTS_URL=http://localhost:8000
# LEECH_TTS_TOKEN=
# LEECH_YT_URL=http://localhost:8000
# LEECH_YT_TOKEN=
# LEECH_HUB_URL=
# LEECH_HUB_TOKEN=

# ============ deployment (deploy/supervisor.py) ============
# SUPERVISOR_PORT=8085
# SUPERVISOR_TOKEN=choose-something-long
# the channel the supervisor tracks (default canary)
# LEECH_CHANNEL_BRANCHES=canary,master
# seconds between autopull checks / probe patience
# AUTOPULL_SECS=45
# SUPERVISOR_PROBE_SECS=75
# where the channel state file lives
# LEECH_CHANNEL_STATE=deploy/channel.json

DISCORD_TOKEN=YOUR_DISCORD_TOKEN
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
BOT_ID=YOUR_BOT_ID
OWNER_ID=YOUR_OWNER_ID

# DISCORD
DISCORD_TOKEN=YOUR_DISCORD_TOKEN
BOT_ID=YOUR_BOT_ID
OWNER_ID=YOUR_OWNER_ID

# AI
# API
AI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY

# SETTINGS
# ai chain controls which ai models attempted to run first (leave blank for no ai)
# ai chain is like provider:model-name
# supported providers are gemini, groq
AI_CHAIN="groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite"
# the thinking effor of ai (low, high, off)
AI_THINKING=low
# the entier turn deadline (in seconds) this includes multiple commands and feedback loops
AI_TURN_DEADLINE=75
# the timeout on each request (in seconds)
AI_TIMEOUT=20
# the window messages count limit
AI_WINDOW_LIMIT=60
# the window char count limit
AI_WINDOW_BUDGET=8000
# prefixes to trigger the bot
PREFIXES = ">, $"
